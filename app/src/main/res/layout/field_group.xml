<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/field_group_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16dp"
        android:textColor="@color/white"
        android:fontFamily="@font/inter_medium"
        android:text="@string/defaults"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"/>
    <TextView
        android:id="@+id/field_group_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:textColor="@color/settings_description"
        android:fontFamily="@font/inter_light"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:text="@string/the_top_source_will_be_considered_primary" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/field_group_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/settings_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/field_group_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:divider="@drawable/settings_divider"
            android:showDividers="middle">

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
